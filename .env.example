# Contacts sync cron (api/sync-contacts.js). Values live in Vercel env vars + LastPass only.
# This file lists NAMES with empty values. Never commit real secrets (public repo).

# GHL private integration token (read contacts + custom fields)
GHL_PRIVATE_TOKEN=
# GHL location that holds the contacts to sync (verify main vs vendor location before first run)
GHL_LOCATION_ID=
# The existing Supabase edge function the cron replays contacts through
GHL_WEBHOOK_URL=
# Shared secret the edge function checks (x-webhook-secret); same value as the edge function env
GHL_WEBHOOK_SECRET=
# Protects the cron endpoint; Vercel Cron sends it as "Authorization: Bearer <value>"
CRON_SECRET=
# Supabase project URL for the incremental watermark, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Supabase service-role key (backend only) used to read/advance the sync_state cursor
# and to call record_lead_event() from api/ghl-event-webhook.js
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the GHL forms/surveys/events webhook (api/ghl-event-webhook.js) checks,
# sent by each GHL workflow as ?secret=<value> or the x-webhook-secret header
GHL_EVENTS_WEBHOOK_SECRET=
# Optional: lookback window in hours (default 50; >48h so one missed daily run self-heals)
SYNC_LOOKBACK_HOURS=
# Optional: how many contacts to replay in parallel (default 4; higher risks GHL 429s)
SYNC_CONCURRENCY=
# Optional: contacts per page in full resync mode ?full=1 (default 50, max 100)
SYNC_FULL_PAGE_SIZE=
# Optional: wall-clock budget in ms before deferring remaining replays (default 55000; keep < maxDuration)
SYNC_MAX_RUN_MS=

# --- Form-submission sync cron (api/sync-form-submissions.js) ---
# Reuses GHL_PRIVATE_TOKEN, GHL_LOCATION_ID (forms live in the operational location),
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and CRON_SECRET above. All below are optional:
# Optional: rolling re-scan window in days (default 14; idempotent writes self-heal a missed run)
FORMS_LOOKBACK_DAYS=
# Optional: submissions written in parallel (default 4)
FORMS_CONCURRENCY=
# Optional: max submission pages per form in incremental mode (default 10; 100 subs/page)
FORMS_MAX_PAGES=
# Optional: wall-clock budget in ms before deferring (default 55000; keep < maxDuration)
FORMS_MAX_RUN_MS=

# --- Listings feed (Airtable Properties -> lead_events, in sync-form-submissions.js) ---
# Airtable personal access token with read scope on the Properties base. If unset,
# the listings pull is skipped (forms + internal feeds still run).
AIRTABLE_API_KEY=
# Optional: Properties base/table (defaults to the live Property Listings base/table)
LISTINGS_BASE_ID=
LISTINGS_TABLE=

# --- GA4 traffic sync cron (api/sync-ga4.js) ---
# Reuses SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and CRON_SECRET above.
# Auth is an OAuth refresh token (org policy blocks service-account keys).
# GA4 property id (numeric), e.g. 528122699
GA4_PROPERTY_ID=
# OAuth client id + secret (Credentials -> OAuth client ID, Web application)
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
# Long-lived refresh token for a Google user with Viewer on the GA4 property
GA4_REFRESH_TOKEN=
# Optional: rolling re-pull window in days (default 30; late GA4 data corrects in place)
GA4_LOOKBACK_DAYS=
# Optional: window used for ?full=1 backfills (default 400)
GA4_FULL_DAYS=

# --- Dashboard access (api/login.mjs + api/dashboard-data.mjs) ---
# Password the dashboard asks for before showing any data (member names are included).
DASHBOARD_PASSWORD=
# HMAC key that signs/verifies the login session cookie. Use a long random string
# (e.g. `openssl rand -base64 48`). Rotating it logs everyone out.
DASHBOARD_SESSION_SECRET=